{
  "name": "fontjs",
  "version": "3.0.1",
  "description": "FontJS (Font.js) is a packages for TrueType font parsing and manipulation",
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "module": "./build/mjs/index.js",
  "main": "./build/cjs/index.js",
  "types": "./build/types/index.d.ts",
  "author": {
    "email": "yury@strozhevsky.com",
    "name": "Yury Strozhevsky"
  },
  "contributors": [
    {
      "email": "rmh@unmitigatedrisk.com",
      "name": "Ryan Hurst"
    }
  ],
  "scripts": {
    "test": "vitest run",
    "clear": "rimraf build/* docs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "build": "npm run build:module && npm run build:types",
    "build:module": "rollup -c",
    "prebuild:types": "rimraf build/types",
    "build:types": "tsc -p tsconfig.json --outDir build/types --declaration --emitDeclarationOnly",
    "rebuild": "npm run clear && npm run build",
    "coverage": "vitest run --coverage",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "TrueType"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PeculiarVentures/Font.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "rimraf": "^3.0.2",
    "rollup": "^2.75.3",
    "rollup-plugin-typescript2": "^0.31.2",
    "typescript": "4.7.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "asn1js": "^3.0.5",
    "bytestreamjs": "^2.0.0",
    "pkijs": "^3.0.4",
    "pvtsutils": "^1.3.2"
  },
  "license": "BSD-3-Clause"
}
