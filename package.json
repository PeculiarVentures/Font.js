{
  "name": "fontjs",
  "version": "3.0.1",
  "description": "Parse, edit, subset and write TrueType fonts",
  "type": "module",
  "sideEffects": false,
  "main": "./build/index.js",
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": "./build/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "build/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build": "tsdown",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "keywords": [
    "font",
    "truetype",
    "ttf",
    "opentype",
    "sfnt",
    "cmap",
    "glyf",
    "subset"
  ],
  "author": {
    "email": "yury@strozhevsky.com",
    "name": "Yury Strozhevsky"
  },
  "contributors": [
    {
      "email": "rmh@unmitigatedrisk.com",
      "name": "Ryan Hurst"
    }
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/PeculiarVentures/Font.js"
  },
  "bugs": {
    "url": "https://github.com/PeculiarVentures/Font.js/issues"
  },
  "homepage": "https://github.com/PeculiarVentures/Font.js#readme",
  "peerDependencies": {
    "bytestreamjs": "^3.0.0"
  },
  "dependencies": {
    "@peculiar/utils": "^4.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "asn1js": "^4.0.0",
    "bytestreamjs": "^3.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "pkijs": "^4.0.1",
    "tsdown": "^0.23.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
